# Herdr configuration, installed by tools/herdr/install.sh.
#
# Herdr keeps runtime state in this same directory (herdr.sock, herdr-server.log,
# session.json), so this file is copied here rather than symlinked out of the
# dotfiles repo. Normal installation preserves edited configs and reports drift.
# Explicit --refresh-config backs up and replaces the file with this template.
#
# Apply changes to a running server without dropping panes:
#   herdr server reload-config

onboarding = false

[theme]
# Matches Neovim's tokyonight-night (folke/tokyonight.nvim) and the "Tokyo Night"
# Windows Terminal scheme in platforms/windows/wt-color-scheme.sh.
# Built-ins: catppuccin, terminal, tokyo-night, dracula, nord, gruvbox,
#            one-dark, solarized, kanagawa, rose-pine, vesper
name = "tokyo-night"

[update]
# The binary is pinned in config/versions.env and verified against a committed
# digest. A background updater would move it out from under that pin, so new
# releases are noticed by `make pins-check` instead.
version_check = false

[ui]
hide_tab_bar_when_single_tab = true
prompt_new_workspace_name = false
agent_panel_sort = "priority"

[ui.toast]
delivery = "herdr"

[ui.sidebar.agents]
rows = [["state_icon"]]

[ui.sidebar.spaces]
# Optional workspace metadata: project headings can report a needs-you count.
rows = [["state_icon", "workspace", { token = "$needs", fg = "#f7768e", bold = true, rules = [{ equals = "0", hide = true }] }]]
