# Managed by dotfiles: coordinator VM
[Unit]
Description=Herdr session for project coordinators

[Service]
Type=exec
WorkingDirectory=%h
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/mise exec -- %h/.local/bin/herdr server
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
