# Managed by dotfiles: coordinator VM
[Unit]
Description=Herdr session for project coordinators

[Service]
Type=exec
WorkingDirectory=%h
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
# Herdr directly, not through `mise exec`: that would install every tool in
# the global mise config at boot, and the server profile installs only some.
# Panes get their tools from the login shell.
ExecStart=%h/.local/bin/herdr server
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
