# Managed by dotfiles: coordinator VM
[Unit]
Description=Herdr session for project coordinators

[Service]
Type=exec
WorkingDirectory=%h
# The user manager may predate the switch to zsh, so name the pane shell and
# the mise shims here rather than inherit them.
Environment="SHELL=/usr/bin/zsh"
Environment="PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin"
# Panes Herdr restores after a restart must not stop at the keyring password
# prompt. dotfiles-keyring-unlock.service unlocks it at boot once sealed;
# otherwise unlock by hand with `make keyring-unlock`.
Environment="DOTFILES_KEYRING_PROMPT=0"
# Herdr directly, not through `mise exec`: that would install every tool in
# the global mise config at boot, and the server profile installs only some.
# Panes get their tools from the login shell.
ExecStart=%h/.local/bin/herdr server
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
