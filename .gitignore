core/git/gitconfig.local.symlink
# Machine-local secondary GitHub identities (name, email, signing key), one
# per identity slug in the owner map: gitconfig.<slug>.symlink. The tracked
# template is core/git/gitconfig.secondary.symlink.example. The pattern needs a
# slug between the dots, so the tracked gitconfig.symlink is not matched.
core/git/gitconfig.*.symlink
.dotfiles-profile
.opencode/

# Python runtime artifacts
__pycache__/
*.py[cod]

# Machine-local Pi plans and retired Claude-era state are not tracked.
.pi/plans/
.pi/overnight-run-state.md
.claude/
projects/

# Machine-local owner map (see identity-owners.local.example).
core/git/identity-owners.local

# Machine-local work aliases and environment — employer-specific identifiers
# never live in tracked files (see work/aliases.local.zsh.example).
work/*.local.zsh
