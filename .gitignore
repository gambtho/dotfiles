# Machine-local secondary GitHub identities (name, email, signing key), one
# per identity slug in the owner map: gitconfig.<slug>.symlink. The tracked
# template is core/git/gitconfig.secondary.symlink.example. The pattern needs a
# slug between the dots, so the tracked gitconfig.symlink is not matched.
core/git/gitconfig.*.symlink
.dotfiles-profile
.opencode/
ai/codex/projects.local.toml

# Python runtime artifacts
__pycache__/
*.py[cod]

# The global ~/.gitignore ignores all CLAUDE.md files (project-local instructions).
# Our repo-managed global CLAUDE.md is an intentional tracked exception.
!ai/claude/CLAUDE.md

# Per-project Claude overlays used to be tracked here. They described the
# architecture and security boundaries of non-public codebases, so they now live
# in a separate private repository that bootstrap clones to ~/.dotfiles/projects.
# This repo is public: nothing under projects/ may be tracked again. The
# assertion in tests/repository_hygiene.bats enforces that; see
# docs/guides/project-overlays.md for the workflow.
# (The dev platform's machine-local projects/*/workspace.local.yaml is covered
# by this rule too.)
projects/

# Machine-local owner map (see identity-owners.local.example).
core/git/identity-owners.local
