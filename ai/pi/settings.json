{
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "theme": "dark",
  "showCacheMissNotices": true,
  "powerline": {
    "queue": { "compactPromptMode": "native" },
    "cache_read": { "format": "both" }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000,
    "modelOverrides": {
      "github-copilot/gpt-6-luna": {
        "reserveTokens": 650000,
        "keepRecentTokens": 60000
      },
      "github-copilot/gpt-6.1-sol": {
        "reserveTokens": 650000,
        "keepRecentTokens": 60000
      },
      "github-copilot/gpt-6-astra": {
        "reserveTokens": 650000,
        "keepRecentTokens": 60000
      },
      "github-copilot/claude-opus-5.5": {
        "reserveTokens": 650000,
        "keepRecentTokens": 60000
      }
    }
  },
  "defaultTools": ["+codemode"],
  "codemode": {
    "mode": "on"
  },
  "packages": [
    {
      "source": "git:github.com/tmustier/pi-extensions",
      "extensions": [
        "raw-paste/index.ts",
        "session-recap/index.ts",
        "usage-extension/index.ts",
        "pi-ralph-wiggum/index.ts",
        "code-actions/index.ts"
      ],
      "skills": [
        "pi-ralph-wiggum/SKILL.md"
      ],
      "prompts": [],
      "themes": []
    },
    "npm:pi-powerline-footer",
    {
      "source": "npm:pi-amplike",
      "extensions": [
        "extensions/btw.ts",
        "extensions/handoff.ts",
        "extensions/modes.ts",
        "extensions/session-query.ts"
      ],
      "skills": [
        "skills/session-query/SKILL.md"
      ],
      "prompts": [],
      "themes": []
    },
    "git:github.com/tmustier/pi-queue-steer",
    "npm:pi-web-access",
    "npm:@narumitw/pi-lsp",
    "npm:@gotgenes/pi-permission-system",
    "npm:@gotgenes/pi-subagents",
    "npm:@narumitw/pi-worktree",
    "npm:@narumitw/pi-file-context",
    {
      "source": "git:github.com/gambtho/pi-file-editor@v0.1.0",
      "extensions": ["extensions/file-editor.ts"],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    {
      "source": "git:github.com/obra/superpowers"
    },
    {
      "source": "git:github.com/addyosmani/agent-skills",
      "extensions": [],
      "skills": [
        "skills/security-and-hardening/SKILL.md",
        "skills/performance-optimization/SKILL.md"
      ],
      "prompts": [],
      "themes": []
    },
    "~/.dotfiles/ai/marketplace/plugins/my"
  ]
}