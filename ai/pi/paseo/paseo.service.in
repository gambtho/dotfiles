[Unit]
Description=Paseo Pi interface for pi.dpao.la
Conflicts=pi-webui.service

[Service]
Type=simple
WorkingDirectory=%h
Environment=PATH=%h/.dotfiles/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=@DAEMON_ENV_KEYS@
ExecStart=@MANAGED_LAUNCHER@ daemon run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
