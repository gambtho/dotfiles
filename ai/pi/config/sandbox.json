{
  "enabled": true,
  "permissionPromptTimeoutSeconds": 60,
  "ignoreViolations": false,
  "enableWeakerNestedSandbox": false,
  "allowBrowserProcess": false,
  "allowPty": false,
  "network": {
    "allowLocalBinding": true,
    "allowUnauthenticatedSocksProxy": false,
    "allowAllUnixSockets": false,
    "sshProxy": false,
    "allowedDomains": [
      "localhost",
      "127.0.0.1",
      "github.com",
      "*.github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com",
      "npmjs.org",
      "*.npmjs.org",
      "registry.yarnpkg.com",
      "pypi.org",
      "*.pypi.org",
      "files.pythonhosted.org",
      "crates.io",
      "*.crates.io",
      "proxy.golang.org",
      "sum.golang.org",
      "storage.googleapis.com",
      "rubygems.org",
      "*.rubygems.org",
      "repo.maven.apache.org",
      "repo1.maven.org",
      "plugins.gradle.org",
      "services.gradle.org",
      "mise.jdx.dev"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      ".env",
      "*.env",
      "*.env.local",
      "*.env.development",
      "*.env.production",
      "*.env.test",
      "*.pem",
      "*.key",
      "~/.ssh",
      "~/.aws",
      "~/.azure",
      "~/.config/gcloud",
      "~/.kube",
      "~/.docker",
      "__PI_AGENT_DIR__/auth.json",
      "~/.config/google-chrome",
      "~/.config/chromium",
      "~/.mozilla"
    ],
    "allowRead": [
      ".",
      "__PI_AGENT_DIR__/npm",
      "~/.local/bin",
      "~/.local/share/mise",
      "~/.cache/uv",
      "~/.cache/pip",
      "~/.cache/pnpm",
      "~/.npm/_cacache",
      "~/.cargo/registry",
      "~/.cargo/git",
      "~/.rustup",
      "~/go/pkg/mod",
      "~/go/pkg/sumdb",
      "~/.m2/repository",
      "~/.gradle/caches",
      "~/.gradle/wrapper"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "~/.cache/uv",
      "~/.cache/pip",
      "~/.cache/pnpm",
      "~/.npm/_cacache",
      "~/.cargo/registry",
      "~/.cargo/git",
      "~/.rustup",
      "~/go/pkg/mod",
      "~/go/pkg/sumdb",
      "~/.m2/repository",
      "~/.gradle/caches",
      "~/.gradle/wrapper"
    ],
    "denyWrite": [
      ".env",
      "*.env",
      "*.env.local",
      "*.env.development",
      "*.env.production",
      "*.env.test",
      "*.pem",
      "*.key",
      "~/.ssh",
      "~/.aws",
      "~/.azure",
      "~/.config/gcloud",
      "~/.kube",
      "~/.docker",
      "__PI_AGENT_DIR__/auth.json",
      "~/.config/google-chrome",
      "~/.config/chromium",
      "~/.mozilla"
    ]
  }
}
