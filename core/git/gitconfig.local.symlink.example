[user]
	# AUTHORNAME and AUTHOREMAIL are substituted by setup_gitconfig in
	# libexec/bootstrap. They must stay exactly these tokens: any other placeholder
	# is copied through literally and every commit is authored as it.
	name = AUTHORNAME
	email = AUTHOREMAIL
	# signingkey = YOUR_GPG_KEY_ID
# [commit]
#	gpgsign = true
# On WSL, bootstrap adds the installed Windows Git Credential Manager helper.
[credential "https://dev.azure.com"]
	useHttpPath = true
