# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local
[hub]
        protocol = https
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
	excludesfile = ~/.gitignore
	hooksPath = ~/.git-hooks
[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = 1
[push]
        # See `git help config` (search for push.default)
        # for more information on different options of the below setting.
        #
        # Setting to git 2.0 default to suppress warning message
	default = simple
	autoSetupRemote = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process

[pull]
	rebase = false
[init]
	defaultBranch = main
[worktree]
	# Linked worktrees link with a relative `gitdir:` instead of an absolute
	# host path. Under repo-scoped sessions a worktree is reached *through* the
	# repository's container, where the host's absolute path does not exist, so
	# an absolute link makes git fail inside the worktree. Requires git >= 2.48
	# and implies extensions.relativeWorktrees on any repository that creates
	# one -- bin/relink warns when the local git is too old to honor this. Note
	# that this requirement then follows the repository everywhere it is
	# opened once a relative worktree exists, including inside a dev
	# container -- not just on the host that created the worktree.
	useRelativePaths = true
[coderabbit]
	machineId = cli/5bd04c69e8d44ee38277024221b4b453
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Identity routing. Generated by bin/relink from the ACTIVE owner map (see
# core/git/identity-owners) into a gitignored, machine-local file: one
# conditional include per mapped owner. Generated rather than written here
# because which account is the default differs per machine -- a hardcoded owner
# would name the wrong one and silently leave the other unrouted. A missing file
# is ignored by git, so this is inert until relink runs.
[include]
	path = ~/.gitconfig.identity-routes
