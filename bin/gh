#!/usr/bin/env bash
# PATH shim routing `gh` to the identity owning the current repository's
# remote. A shell function would reach only interactive zsh; scripts, editors,
# Pi and other non-interactive callers would all silently use the default
# account -- the exact disagreement this design exists to prevent.
#
# BASH 3.2 ONLY: macOS ships bash 3.2, and tests/portability.bats rejects
# Bash-4-only array builtins anywhere under bin/ -- including in comments,
# since it matches the bare word. Keep that word out of this file.
set -uo pipefail

IDENTITY_DOTFILES_ROOT="${DOTFILES:-$HOME/.dotfiles}"
IDENTITY_LIB="$IDENTITY_DOTFILES_ROOT/core/git/identity-lib.sh"

# Fail closed but readably. Without the library we cannot resolve an owner to
# an identity, and guessing is exactly what this design forbids -- but a moved
# or broken $DOTFILES checkout must not turn every `gh` invocation on the
# machine, including in unrelated repositories, into raw bash "no such file"
# errors.
if [ ! -r "$IDENTITY_LIB" ]; then
  printf 'gh: refusing to run -- identity library not found: %s\n' "$IDENTITY_LIB" >&2
  printf 'gh: cannot route identities without it.\n' >&2
  exit 5
fi
# shellcheck source=/dev/null
. "$IDENTITY_LIB"

# Resolve through symlinks. Comparing raw paths fails to recognise this script
# when invoked through a link, and the exec below then re-enters this file
# forever.
identity_realpath() {
  local target="$1" dir base
  if readlink -f / >/dev/null 2>&1; then
    readlink -f "$target"
    return
  fi
  dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd -P)" || return 1
  base="$(basename "$target")"
  while [ -L "$dir/$base" ]; do
    target="$(readlink "$dir/$base")"
    case "$target" in
      /*) : ;;
      *) target="$dir/$target" ;;
    esac
    dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd -P)" || return 1
    base="$(basename "$target")"
  done
  printf '%s/%s\n' "$dir" "$base"
}

find_real_gh() {
  local self entry candidate rest="$PATH"
  self="$(identity_realpath "${BASH_SOURCE[0]}")"
  while [ -n "$rest" ]; do
    entry="${rest%%:*}"
    if [ "$entry" = "$rest" ]; then
      rest=""
    else
      rest="${rest#*:}"
    fi
    [ -n "$entry" ] || continue
    candidate="$entry/gh"
    [ -x "$candidate" ] || continue
    [ "$(identity_realpath "$candidate")" = "$self" ] && continue
    # A manual /usr/local install can outlive the distro package update.
    # Prefer the package-managed CLI on Linux without changing custom PATH
    # overrides or Homebrew selection on other platforms.
    if [ "$candidate" = /usr/local/bin/gh ] && [ "$(uname -s)" = Linux ] &&
      [ -x /usr/bin/gh ] && [ "$(identity_realpath /usr/bin/gh)" != "$self" ]; then
      candidate=/usr/bin/gh
    fi
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

real_gh="$(find_real_gh)" || {
  printf 'gh: no real gh found on PATH\n' >&2
  exit 127
}

exec_real_gh() {
  local helper="$IDENTITY_DOTFILES_ROOT/libexec/keyring"
  if [ "$(uname -s)" = Linux ] && [ -r "$helper" ] && [ -x /usr/bin/python3 ]; then
    # The preflight must not consume stdin (Git's credential protocol, API input,
    # etc.) or prompt. Identity selection has already established the config.
    if ! /usr/bin/python3 "$helper" gh-check -- "$@" </dev/null; then
      printf 'gh: credential keyring locked or unavailable; unlock in a human terminal:\n' >&2
      printf '  make -C %q keyring-unlock\n' "$IDENTITY_DOTFILES_ROOT" >&2
      printf 'gh: if the login keyring is absent, initialize it first:\n' >&2
      printf '  make -C %q keyring-init\n' "$IDENTITY_DOTFILES_ROOT" >&2
      if [ -e /etc/systemd/system/dotfiles-keyring-unlock.service ]; then
        printf 'gh: boot unlock failed: systemctl status dotfiles-keyring-unlock\n' >&2
      fi
      if [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/dotfiles-keyring-unlock.service" ]; then
        printf 'gh: boot unlock failed: systemctl --user status dotfiles-keyring-unlock\n' >&2
      fi
      exit 6
    fi
  fi
  # setup-git writes --global; keep those writes off the tracked config.
  if [ "${1-}" = auth ] && [ "${2-}" = setup-git ] && [ "${GIT_CONFIG_GLOBAL+x}" != x ]; then
    GIT_CONFIG_GLOBAL="$HOME/.gitconfig.local" exec "$real_gh" "$@"
  fi
  # login is not redirected: gh reads the configured helper to decide whether to
  # offer Git setup, and must see the tracked one. It skips the offer when that
  # helper is gh's own, so a write here means it found another; say so.
  if [ "${1-}" = auth ] && [ "${2-}" = login ]; then
    run_login_and_check_tracked_config "$@"
  fi
  exec "$real_gh" "$@"
}

run_login_and_check_tracked_config() {
  local config dir root path before after status clean=false
  # gh writes Git settings to the global config; follow it to a tracked file.
  config="$(identity_realpath "${GIT_CONFIG_GLOBAL:-$HOME/.gitconfig}" 2>/dev/null)" || exec "$real_gh" "$@"
  dir="$(dirname "$config")"
  root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || exec "$real_gh" "$@"
  path="${config#"$root"/}"
  git -C "$root" ls-files --error-unmatch -- "$path" >/dev/null 2>&1 || exec "$real_gh" "$@"
  before="$({ cksum <"$config"; } 2>/dev/null)" || exec "$real_gh" "$@"
  git -C "$root" diff --quiet HEAD -- "$path" 2>/dev/null && clean=true
  "$real_gh" "$@"
  status=$?
  after="$({ cksum <"$config"; } 2>/dev/null)" || after=""
  if [ "$after" != "$before" ]; then
    printf 'gh: the tracked Git config %s changed during auth login.\n' "$config" >&2
    printf 'gh: it already makes gh Git'"'"'s credential helper. Check the change:\n' >&2
    printf 'gh:   git -C %q diff -- %q\n' "$root" "$path" >&2
    if [ "$clean" = true ]; then
      printf 'gh: it had no other changes before login; if this is only credential helper lines, undo it:\n' >&2
      printf 'gh:   git -C %q checkout -- %q\n' "$root" "$path" >&2
    else
      printf 'gh: it already had uncommitted changes, so remove only the helper lines (git checkout -p).\n' >&2
    fi
  fi
  exit "$status"
}

# An explicit GH_CONFIG_DIR means the caller has already chosen. Never
# second-guess it -- it is the documented escape hatch for mixed-owner repos.
if [ -n "${GH_CONFIG_DIR:-}" ]; then
  exec_real_gh "$@"
fi

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exec_real_gh "$@"

# Inside a git repository, an unusable map is a hard error. Falling through
# would silently use the default account for a repo that may not be its.
if ! identity_validate_map; then
  printf 'gh: refusing to run -- the owner map is unusable (see above).\n' >&2
  exit 5
fi

owners=""
owner_count=0
while IFS= read -r owner; do
  [ -n "$owner" ] || continue
  owners="$owners $owner"
  owner_count=$((owner_count + 1))
done < <(identity_repo_owners)

if [ "$owner_count" -eq 0 ]; then
  exec_real_gh "$@"
fi

if [ "$owner_count" -gt 1 ]; then
  printf 'gh: refusing to run -- remotes under mixed mapped identities:%s\n' "$owners" >&2
  printf 'gh: re-run with an explicit GH_CONFIG_DIR (and GH_REPO if needed).\n' >&2
  exit 3
fi

owner="${owners# }"
slug="$(identity_owner_slug "$owner")"

if [ "$slug" = default ]; then
  exec_real_gh "$@"
fi

if ! identity_slug_provisioned "$slug"; then
  printf 'gh: identity "%s" is mapped but not provisioned.\n' "$slug" >&2
  printf 'gh: expected %s and %s.\n' \
    "$(identity_slug_configfile "$slug")" "$(identity_slug_configdir "$slug")" >&2
  identity_slug_provision_hint "$slug" 'gh: ' >&2
  exit 4
fi

GH_CONFIG_DIR="$(identity_slug_configdir "$slug")"
export GH_CONFIG_DIR
exec_real_gh "$@"
