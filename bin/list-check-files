#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: bin/list-check-files {bash|zsh|shellcheck|shfmt}\n' >&2
}

class=${1:-}
case "$class" in
  bash | zsh | shellcheck | shfmt) ;;
  *)
    usage
    exit 2
    ;;
esac

if [[ $(git rev-parse --is-inside-work-tree 2>/dev/null || true) != true ]]; then
  printf '%s\n' 'bin/list-check-files must run inside a Git checkout.' >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

is_shell_name() {
  case "${1##*/}" in
    bash | sh | dash | ksh | zsh) return 0 ;;
    *) return 1 ;;
  esac
}

is_known_incompatible_interpreter() {
  case "${1##*/}" in
    python | python3 | node | ruby | perl | fish | pwsh | powershell | php) return 0 ;;
    *) return 1 ;;
  esac
}

is_command_shell() {
  local path="$1" name first_line interpreter target word
  local index options_done
  local -a shebang_words=()
  # Direct shell entries in public bin/ and private libexec/, plus sourced
  # library slices under each directory's lib/ — a lib file that escaped the
  # shell gates could drift unchecked while every installer still sources it.
  # An explicit non-shell shebang is excluded; ambiguous extensionless entries
  # stay in the shell gates so a new file cannot silently escape validation.
  [[ "$path" == bin/* || "$path" == libexec/* ]] || return 1
  case "${path#*/}" in
    */*) [[ "$path" == bin/lib/*.sh || "$path" == libexec/lib/*.sh ]] && return 0 ;;
    *)
      name=${path#*/}
      [[ "$name" == *.sh ]] && return 0
      [[ "$name" == *.* ]] && return 1

      first_line=
      IFS= read -r first_line <"$path" || :
      [[ "$first_line" == '#!'* ]] || return 0
      read -r -a shebang_words <<<"${first_line#\#!}"
      ((${#shebang_words[@]} > 0)) || return 0

      interpreter=${shebang_words[0]##*/}
      is_shell_name "$interpreter" && return 0
      is_known_incompatible_interpreter "$interpreter" && return 1
      [[ "$interpreter" == env ]] || return 0
      ((${#shebang_words[@]} > 1)) || return 0

      index=1
      options_done=0
      target=
      while ((index < ${#shebang_words[@]})); do
        word=${shebang_words[index]}
        if ((options_done == 0)); then
          case "$word" in
            --)
              options_done=1
              index=$((index + 1))
              continue
              ;;
            -S | -i | --ignore-environment | - | -v | --debug | -0 | --null)
              index=$((index + 1))
              continue
              ;;
            -u | --unset | -C | --chdir | -a | --argv0)
              index=$((index + 2))
              continue
              ;;
            --unset=* | --chdir=* | --argv0=*)
              index=$((index + 1))
              continue
              ;;
            -*)
              # Unknown env syntax is ambiguous, so fail loudly through the
              # shell gates instead of silently excluding the file.
              return 0
              ;;
          esac
        fi
        if [[ "$word" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
          index=$((index + 1))
          continue
        fi
        target=$word
        break
      done
      [[ -n "$target" ]] || return 0
      is_shell_name "$target" && return 0
      ! is_known_incompatible_interpreter "$target"
      ;;
  esac
}

is_repository_sh() {
  case "$1" in
    ai/* | core/* | fonts/* | languages/* | platforms/* | work/*) [[ "$1" == *.sh ]] ;;
    *) return 1 ;;
  esac
}

is_tool_shell() {
  local path="$1" name
  [[ "$path" == tools/* ]] || return 1
  name=${path##*/}
  # Extensionless executables (dev-event, dev-autostart, installer entry
  # points) and .sh sources are bash; everything else under tools/ is data for
  # another consumer (.yaml config, .tmux.conf, .service unit,
  # commit.msg.example) or belongs to the zsh class (.zsh plugins and aliases).
  # The prefix is tools/ rather than tools/dev/ so a new tool directory is
  # covered by the shell gates on the day it is added, instead of silently
  # passing `make check` because nothing looked at it.
  [[ "$name" != *.* || "$name" == *.sh ]]
}

is_repository_zsh() {
  case "$1" in
    core/shell/*.symlink) return 0 ;;
    core/* | languages/* | platforms/* | profiles/* | tools/* | work/*) [[ "$1" == *.zsh ]] ;;
    *) return 1 ;;
  esac
}

{
  git ls-files -z
  git ls-files -z --others --exclude-standard
} | while IFS= read -r -d '' path; do
  [[ -f "$path" ]] || continue
  case "$class" in
    bash)
      if is_command_shell "$path" || is_repository_sh "$path" || is_tool_shell "$path"; then printf '%s\0' "$path"; fi
      ;;
    zsh)
      if is_repository_zsh "$path"; then printf '%s\0' "$path"; fi
      ;;
    shellcheck)
      if is_command_shell "$path" || is_repository_sh "$path" || is_tool_shell "$path"; then printf '%s\0' "$path"; fi
      ;;
    shfmt)
      # tests/*.bats is shfmt-only: `bash -n` and shellcheck cannot parse the
      # `@test "name" { ... }` form, but shfmt has understood it since v3.2.0
      # (mvdan/sh, 2020-10-29). An shfmt older than that fails loudly on these
      # paths rather than skipping them.
      if is_command_shell "$path" || is_repository_sh "$path" || is_tool_shell "$path" || [[ "$path" == tests/test_helper.bash ]] || [[ "$path" == tests/*.bats ]]; then printf '%s\0' "$path"; fi
      ;;
  esac
done
