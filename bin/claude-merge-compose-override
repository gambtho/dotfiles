#!/usr/bin/env bash
# Render a project-local Compose override and devcontainer seed script.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
# shellcheck source=bin/common.sh
source "$SCRIPT_DIR/common.sh"

SEED_TEMPLATE="$ROOT/ai/marketplace/plugins/my/skills/project-claude-setup/templates/local-seed.sh"
COMPOSE_TEMPLATE="$ROOT/ai/marketplace/plugins/my/skills/project-claude-setup/templates/compose-override.yml"

usage() {
  cat <<'EOF'
Usage: claude-merge-compose-override \
  --service NAME \
  --remote-user USER \
  --remote-home PATH \
  --seed-file HOST_PATH \
  --seed-container-path CONTAINER_PATH \
  --base-command-json JSON \
  --workspace CONTAINER_WORKSPACE \
  [--share-host-auth] \
  [--dry-run] \
  OVERRIDE_PATH
EOF
}

die_usage() {
  printf '%s\n' "$*" >&2
  exit 2
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

require_value() {
  [[ $# -ge 2 && -n "$2" ]] || die_usage "$1 requires a value"
}

SERVICE=""
REMOTE_USER=""
REMOTE_HOME=""
SEED_FILE=""
SEED_CONTAINER_PATH=""
BASE_COMMAND_JSON=""
WORKSPACE=""
SHARE_HOST_AUTH=0
DRY_RUN=0
OVERRIDE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --service)
      require_value "$@"
      SERVICE="$2"
      shift 2
      ;;
    --remote-user)
      require_value "$@"
      REMOTE_USER="$2"
      shift 2
      ;;
    --remote-home)
      require_value "$@"
      REMOTE_HOME="$2"
      shift 2
      ;;
    --seed-file)
      require_value "$@"
      SEED_FILE="$2"
      shift 2
      ;;
    --seed-container-path)
      require_value "$@"
      SEED_CONTAINER_PATH="$2"
      shift 2
      ;;
    --base-command-json)
      require_value "$@"
      BASE_COMMAND_JSON="$2"
      shift 2
      ;;
    --workspace)
      require_value "$@"
      WORKSPACE="$2"
      shift 2
      ;;
    --share-host-auth)
      SHARE_HOST_AUTH=1
      shift
      ;;
    -n | --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*) die_usage "unknown flag: $1" ;;
    *)
      [[ -z "$OVERRIDE" ]] || die_usage "multiple override paths supplied"
      OVERRIDE="$1"
      shift
      ;;
  esac
done

[[ -n "$SERVICE" ]] || die_usage "--service required"
[[ "$SERVICE" =~ ^[A-Za-z0-9._-]+$ ]] || die_usage "invalid --service"
[[ -n "$REMOTE_USER" ]] || die_usage "--remote-user required"
[[ "$REMOTE_USER" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] || die_usage "invalid --remote-user"
[[ -n "$REMOTE_HOME" ]] || die_usage "--remote-home required"
[[ "$REMOTE_HOME" == /* && "$REMOTE_HOME" != *:* && "$REMOTE_HOME" != *$'\n'* ]] ||
  die_usage "absolute --remote-home required"
[[ -n "$SEED_FILE" ]] || die_usage "--seed-file required"
[[ -n "$SEED_CONTAINER_PATH" ]] || die_usage "--seed-container-path required"
[[ "$SEED_CONTAINER_PATH" == /* && "$SEED_CONTAINER_PATH" != *:* && "$SEED_CONTAINER_PATH" != *$'\n'* ]] ||
  die_usage "absolute --seed-container-path required"
[[ -n "$BASE_COMMAND_JSON" ]] || die_usage "--base-command-json required"
[[ -n "$WORKSPACE" ]] || die_usage "--workspace required"
[[ "$WORKSPACE" == /* && "$WORKSPACE" != *:* && "$WORKSPACE" != *$'\n'* ]] ||
  die_usage "absolute --workspace required"
# `#`, `&` and `\` are metacharacters in the sed replacement that renders this
# into the seed; a container workspace path containing one is rejected rather
# than silently mangled.
[[ "$WORKSPACE" != *'#'* && "$WORKSPACE" != *'&'* && "$WORKSPACE" != *'\'* ]] ||
  die_usage "invalid --workspace"
[[ -n "$OVERRIDE" ]] || die_usage "override path required"
[[ "$OVERRIDE" != "$SEED_FILE" ]] || die_usage "override and seed paths must differ"
[[ -d "$(dirname "$OVERRIDE")" ]] || die_usage "override directory does not exist"
[[ -d "$(dirname "$SEED_FILE")" ]] || die_usage "seed directory does not exist"

command -v jq >/dev/null || die "jq is required"
if ! jq -e '(type == "string" and length > 0) or
  (type == "array" and length > 0 and all(.[]; type == "string"))' \
  <<<"$BASE_COMMAND_JSON" >/dev/null 2>&1; then
  die_usage "invalid --base-command-json"
fi

command -v yq >/dev/null || die "yq is required"
yq --version 2>&1 | grep -qi mikefarah ||
  die "yq is not mikefarah/yq; merge semantics differ"

[[ -f "$SEED_TEMPLATE" ]] || die "missing seed template: $SEED_TEMPLATE"
[[ -f "$COMPOSE_TEMPLATE" ]] || die "missing Compose template: $COMPOSE_TEMPLATE"
yq -e 'type == "!!map"' "$COMPOSE_TEMPLATE" >/dev/null 2>&1 ||
  die "invalid Compose template"
if [[ -e "$OVERRIDE" || -L "$OVERRIDE" ]]; then
  [[ -f "$OVERRIDE" ]] || die "override is not a regular file: $OVERRIDE"
  yq -e 'type == "!!map"' "$OVERRIDE" >/dev/null 2>&1 ||
    die "invalid existing Compose: $OVERRIDE"
fi

VOLUMES_JSON='[]'
add_volume() {
  VOLUMES_JSON="$(jq -c --arg value "$1" '. + [$value]' <<<"$VOLUMES_JSON")"
}

for relative in settings.json CLAUDE.md config commands skills; do
  if [[ -e "$HOME/.claude/$relative" || -L "$HOME/.claude/$relative" ]]; then
    add_volume "$HOME/.claude/$relative:/host-seed/.claude/$relative:ro"
  fi
done
if [[ -d "$HOME/.dotfiles" ]]; then
  add_volume "$HOME/.dotfiles:/host-seed/.dotfiles:ro"
fi

add_volume "claude-local-home:$REMOTE_HOME/.claude"
add_volume "dotfiles-local-home:$REMOTE_HOME/.dotfiles"
if ((SHARE_HOST_AUTH)) && [[ -d "$HOME/.ssh" ]]; then
  add_volume "$HOME/.ssh:$REMOTE_HOME/.ssh:ro"
else
  add_volume "ssh-local-home:$REMOTE_HOME/.ssh"
fi
if ((SHARE_HOST_AUTH)) && [[ -d "$HOME/.config/gh" ]]; then
  add_volume "$HOME/.config/gh:$REMOTE_HOME/.config/gh:ro"
else
  add_volume "gh-local-home:$REMOTE_HOME/.config/gh"
fi
add_volume "opencode-local-home:$REMOTE_HOME/.config/opencode"

if [[ -f "$OVERRIDE" ]]; then
  EXISTING_VOLUMES_JSON="$(SERVICE="$SERVICE" yq -o=json -I=0 \
    '.services[strenv(SERVICE)].volumes // []' "$OVERRIDE")"
  EXISTING_EXTRA_HOSTS_JSON="$(SERVICE="$SERVICE" yq -o=json -I=0 \
    '.services[strenv(SERVICE)].extra_hosts // []' "$OVERRIDE")"
else
  EXISTING_VOLUMES_JSON='[]'
  EXISTING_EXTRA_HOSTS_JSON='[]'
fi

if [[ "$(jq -r type <<<"$BASE_COMMAND_JSON")" == array ]]; then
  COMMAND_JSON="$(jq -c --arg seed "$SEED_CONTAINER_PATH" \
    '["bash", $seed, "--argv"] + .' <<<"$BASE_COMMAND_JSON")"
else
  COMMAND_JSON="$(jq -c --arg seed "$SEED_CONTAINER_PATH" \
    '["bash", $seed, "--shell", .]' <<<"$BASE_COMMAND_JSON")"
fi

MANAGED_TARGETS_JSON="$(jq -cn --arg home "$REMOTE_HOME" '[
  ($home + "/.claude"),
  ($home + "/.dotfiles"),
  ($home + "/.ssh"),
  ($home + "/.config/gh"),
  ($home + "/.config/opencode"),
  "/host-seed/.claude/settings.json",
  "/host-seed/.claude/CLAUDE.md",
  "/host-seed/.claude/config",
  "/host-seed/.claude/commands",
  "/host-seed/.claude/skills",
  "/host-seed/.dotfiles"
]')"

VOLUMES_JSON="$(jq -c \
  --argjson managed "$VOLUMES_JSON" \
  --argjson targets "$MANAGED_TARGETS_JSON" '
    map(select(
      (if type == "object" then .target else (split(":")[1] // "") end) as $target
      | ($targets | index($target)) == null
    )) + $managed
  ' <<<"$EXISTING_VOLUMES_JSON")"
EXTRA_HOSTS_JSON="$(jq -c '
  if type == "object" then . + {"host.docker.internal": "host-gateway"}
  else (. + ["host.docker.internal:host-gateway"] | unique)
  end
' <<<"$EXISTING_EXTRA_HOSTS_JSON")"

export SERVICE VOLUMES_JSON COMMAND_JSON EXTRA_HOSTS_JSON

SEED_STAGE="$(mktemp "${SEED_FILE}.stage.XXXXXX")"
OVERRIDE_STAGE="$(mktemp "${OVERRIDE}.stage.XXXXXX")"
CURRENT_COMPOSE="$(mktemp "${OVERRIDE}.current.XXXXXX")"
cleanup() {
  rm -f -- "$SEED_STAGE" "$OVERRIDE_STAGE" "$CURRENT_COMPOSE"
}
trap cleanup EXIT

sed -e "s/^SEED_USER=\"{USER}\"$/SEED_USER=\"$REMOTE_USER\"/" \
  -e "s#^WORKSPACE=\"{WORKSPACE}\"\$#WORKSPACE=\"$WORKSPACE\"#" \
  "$SEED_TEMPLATE" >"$SEED_STAGE"
if grep -Eq '\{USER\}|\{WORKSPACE\}' "$SEED_STAGE"; then
  die "unresolved seed template placeholder"
fi
bash -n "$SEED_STAGE" || die "rendered seed failed syntax validation"

if [[ -f "$OVERRIDE" ]]; then
  cp -- "$OVERRIDE" "$CURRENT_COMPOSE"
else
  printf '{}\n' >"$CURRENT_COMPOSE"
fi

if ! yq eval-all -P '
  select(fileIndex == 0) as $template |
  select(fileIndex == 1) as $existing |
  ($template * $existing) |
  .services[strenv(SERVICE)] = (.services[strenv(SERVICE)] // {}) |
  .services[strenv(SERVICE)].environment =
    (.services[strenv(SERVICE)].environment // {}) |
  .services[strenv(SERVICE)].environment.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS = "1" |
  .services[strenv(SERVICE)].volumes = (strenv(VOLUMES_JSON) | from_json) |
  .services[strenv(SERVICE)].command = (strenv(COMMAND_JSON) | from_json) |
  .services[strenv(SERVICE)].extra_hosts = (strenv(EXTRA_HOSTS_JSON) | from_json)
' "$COMPOSE_TEMPLATE" "$CURRENT_COMPOSE" >"$OVERRIDE_STAGE"; then
  die "failed to render Compose override"
fi
yq -e 'type == "!!map"' "$OVERRIDE_STAGE" >/dev/null 2>&1 ||
  die "rendered Compose failed validation"

print_diff() {
  local destination="$1" stage="$2" label="$3"
  printf '──── proposed %s ────\n' "$label"
  if [[ -f "$destination" ]]; then
    diff -u "$destination" "$stage" || true
  else
    diff -u /dev/null "$stage" || true
  fi
}

print_diff "$SEED_FILE" "$SEED_STAGE" seed
print_diff "$OVERRIDE" "$OVERRIDE_STAGE" override

if ((DRY_RUN)); then
  printf '%s\n' '--dry-run; not writing.'
  exit 0
fi

SEED_CHANGED=1
OVERRIDE_CHANGED=1
[[ -f "$SEED_FILE" ]] && cmp -s "$SEED_FILE" "$SEED_STAGE" && SEED_CHANGED=0
[[ -f "$OVERRIDE" ]] && cmp -s "$OVERRIDE" "$OVERRIDE_STAGE" && OVERRIDE_CHANGED=0
if ((SEED_CHANGED == 0 && OVERRIDE_CHANGED == 0)); then
  printf '%s\n' 'no changes'
  exit 0
fi

SEED_EXISTED=0
OVERRIDE_EXISTED=0
SEED_BACKUP=""
OVERRIDE_BACKUP=""
if ((SEED_CHANGED)) && [[ -f "$SEED_FILE" ]]; then
  SEED_EXISTED=1
  SEED_BACKUP="$(next_backup_path "$SEED_FILE")"
  cp -p -- "$SEED_FILE" "$SEED_BACKUP"
fi
if ((OVERRIDE_CHANGED)) && [[ -f "$OVERRIDE" ]]; then
  OVERRIDE_EXISTED=1
  OVERRIDE_BACKUP="$(next_backup_path "$OVERRIDE")"
  cp -p -- "$OVERRIDE" "$OVERRIDE_BACKUP"
fi

SEED_PUBLISHED=0
OVERRIDE_PUBLISHED=0
ROLLBACK_INCOMPLETE=0
# One of three stage-then-publish sites in this repo (see publish_atomically in
# build_gallery.py and publish_settings in setup-wt-claude-profiles.sh). They
# share an invariant rather than an implementation: replace a destination only
# with a complete file, leave previous contents intact on failure, keep the
# destination's mode rather than the stage's private default, and leave no stage
# behind. Mirror changes to those rules across all three.
#
# Publication limit: POSIX offers no way to rename two files as one transaction,
# so a reader sampling the directory between the two `mv` calls below can
# observe a new seed alongside the old override. Both renames are individually
# atomic and everything fallible (rendering, YAML validation, backups) happens
# before the first one, so the window is two adjacent renames wide and any
# failure inside it triggers rollback. That is the floor for two files without a
# directory-level commit; callers that cannot tolerate it should stop the stack
# before running this.
rollback() {
  # Restores are best-effort: a failing restore must not abort rollback via
  # errexit, because that would skip the remaining file and leave the operator
  # with no message naming what was lost. Each failure is reported instead.
  if ((OVERRIDE_PUBLISHED)); then
    if ((OVERRIDE_EXISTED)); then
      if ! cp -p -- "$OVERRIDE_BACKUP" "$OVERRIDE"; then
        ROLLBACK_INCOMPLETE=1
        printf 'warning: %s could not be restored; recover it from %s\n' \
          "$OVERRIDE" "$OVERRIDE_BACKUP" >&2
      fi
    else
      rm -f -- "$OVERRIDE"
    fi
  fi
  if ((SEED_PUBLISHED)); then
    if ((SEED_EXISTED)); then
      if ! cp -p -- "$SEED_BACKUP" "$SEED_FILE"; then
        ROLLBACK_INCOMPLETE=1
        printf 'warning: %s could not be restored; recover it from %s\n' \
          "$SEED_FILE" "$SEED_BACKUP" >&2
      fi
    else
      rm -f -- "$SEED_FILE"
    fi
  fi
}

# mktemp stages at 0600 and mv preserves the stage's mode, so carry the
# destination's permissions over before publishing.
preserve_mode() {
  local destination="$1" stage="$2" mode
  if mode="$(stat -c '%a' "$destination" 2>/dev/null)"; then
    chmod "$mode" -- "$stage" || true
  fi
}

if ((SEED_CHANGED)); then
  preserve_mode "$SEED_FILE" "$SEED_STAGE"
  if ! mv -- "$SEED_STAGE" "$SEED_FILE"; then
    rollback
    ((ROLLBACK_INCOMPLETE)) && die "failed to publish seed; rollback incomplete (see warnings above)"
    die "failed to publish seed; restored previous outputs"
  fi
  SEED_PUBLISHED=1
fi
if ((OVERRIDE_CHANGED)); then
  preserve_mode "$OVERRIDE" "$OVERRIDE_STAGE"
  if ! mv -- "$OVERRIDE_STAGE" "$OVERRIDE"; then
    rollback
    ((ROLLBACK_INCOMPLETE)) && die "failed to publish override; rollback incomplete (see warnings above)"
    die "failed to publish override; restored previous outputs"
  fi
  OVERRIDE_PUBLISHED=1
fi

printf 'wrote: %s\n' "$SEED_FILE"
printf 'wrote: %s\n' "$OVERRIDE"
