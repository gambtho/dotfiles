#!/usr/bin/env python3

"""Validate a Pi permission config against an exact installed schema."""

from __future__ import annotations

import argparse
import json
import sys

try:
    from jsonschema import Draft202012Validator
    from jsonschema.exceptions import SchemaError
except ImportError:
    print(
        "error: Python jsonschema is required for Pi permission validation",
        file=sys.stderr,
    )
    raise SystemExit(1)


LOAD_FAILED = object()


def load_json(path: str):
    try:
        with open(path, encoding="utf-8") as stream:
            return json.load(stream)
    except OSError as error:
        message = error.strerror or str(error)
        print(f"error: permission schema {path}: {message}", file=sys.stderr)
        return LOAD_FAILED
    except json.JSONDecodeError as error:
        print(f"error: permission schema {path}: {error.msg}", file=sys.stderr)
        return LOAD_FAILED
    except UnicodeError as error:
        print(f"error: permission schema {path}: {error}", file=sys.stderr)
        return LOAD_FAILED


def validation_error_sort_key(error):
    return tuple(str(part) for part in error.path)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--schema", required=True)
    parser.add_argument("--config", required=True)
    args = parser.parse_args()

    schema = load_json(args.schema)
    if schema is LOAD_FAILED:
        return 1

    config = load_json(args.config)
    if config is LOAD_FAILED:
        return 1

    try:
        Draft202012Validator.check_schema(schema)
    except SchemaError as error:
        print(f"error: permission schema {args.schema}: {error.message}", file=sys.stderr)
        return 1

    errors = sorted(
        Draft202012Validator(schema).iter_errors(config),
        key=validation_error_sort_key,
    )
    for error in errors:
        location = ".".join(str(part) for part in error.path) or "<root>"
        print(f"error: permission schema {location}: {error.message}", file=sys.stderr)
    if errors:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
