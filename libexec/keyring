#!/usr/bin/python3
"""Inspect, initialize or unlock a GNOME Login keyring."""

import argparse
import contextlib
import getpass
import hashlib
import os
import pathlib
import re
import signal
import stat
import sys
import threading
import warnings
import xml.etree.ElementTree as ET

SERVICE = "/org/freedesktop/secrets"
SECRETS = "org.freedesktop.Secret.Service"
PROVIDER = "org.freedesktop.secrets"
INTERNAL = "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface"
DBUS = "org.freedesktop.DBus"
DBUS_PATH = "/org/freedesktop/DBus"


class KeyringError(Exception):
    """An actionable error safe to display without secret payloads."""


class UnsupportedProvider(KeyringError):
    """Leave other Secret Service implementations to the native client."""


class SessionBus:
    def __init__(self):
        # APT installs bindings for system Python; default test discovery and
        # non-Linux invocations must not require GI or contact a live bus.
        try:
            from gi.repository import Gio, GLib
        except ImportError as error:
            raise KeyringError(
                "Missing system Python Gio bindings; install the keyring dependencies."
            ) from error
        self.gio, self.glib = Gio, GLib
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error as error:
            raise KeyringError(
                "Session bus unavailable; WSL needs systemd and a user session bus."
            ) from error

    def call(self, destination, path, interface, method, signature, args):
        if method == "OpenSession":
            args = ("plain", self.glib.Variant("s", ""))
        elif method == "CreateWithMasterPassword":
            args = ({key: self.glib.Variant("s", value) for key, value in args[0].items()}, args[1])
        try:
            result = self.bus.call_sync(
                destination,
                path,
                interface,
                method,
                self.glib.Variant(signature, args),
                None,
                self.gio.DBusCallFlags.NO_AUTO_START,
                10000,
                None,
            )
            return result.unpack()
        except self.glib.Error as error:
            category = self.gio.DBusError.get_remote_error(error)
            if method == "GetNameOwner" and category == DBUS + ".Error.NameHasNoOwner":
                return (None,)
            # Server messages can include arguments: report the operation and
            # error category, never raw messages or request payloads.
            raise KeyringError(
                f"{method} failed ({category or 'local D-Bus error/timeout'})."
            ) from error


class GnomeKeyring:
    def __init__(self, transport=None):
        self.transport = transport if transport is not None else SessionBus()
        self.owner = None
        self.collection = None

    def bus_call(self, method, signature, args):
        return self.transport.call(DBUS, DBUS_PATH, DBUS, method, signature, args)

    def call(self, interface, method, signature, args, path=SERVICE):
        return self.transport.call(self.owner, path, interface, method, signature, args)

    def assert_owner(self):
        for name in (PROVIDER, "org.gnome.keyring"):
            if self.bus_call("GetNameOwner", "(s)", (name,))[0] != self.owner:
                raise KeyringError(
                    "GNOME keyring provider changed; no password will be retried."
                )

    def inspect(self, activate=False, initialize=False):
        self.owner = self.bus_call("GetNameOwner", "(s)", (PROVIDER,))[0]
        if self.owner is None and activate:
            self.bus_call("StartServiceByName", "(su)", (PROVIDER, 0))
            self.owner = self.bus_call("GetNameOwner", "(s)", (PROVIDER,))[0]
        if self.owner is None:
            raise KeyringError(
                "Secret Service inactive; run make keyring-unlock to request native activation."
            )
        if (
            self.bus_call("GetNameOwner", "(s)", ("org.gnome.keyring",))[0]
            != self.owner
        ):
            raise UnsupportedProvider(
                "Unsupported Secret Service provider; GNOME keyring is required."
            )
        xml = self.call("org.freedesktop.DBus.Introspectable", "Introspect", "()", ())[
            0
        ]
        try:
            root = ET.fromstring(xml)
        except ET.ParseError as error:
            raise KeyringError("Invalid GNOME keyring capability response.") from error
        name = "CreateWithMasterPassword" if initialize else "UnlockWithMasterPassword"
        method = root.find(f"./interface[@name='{INTERNAL}']/method[@name='{name}']")
        inputs = ["a{sv}", "(oayays)"] if initialize else ["o", "(oayays)"]
        if method is None or [
            arg.get("type") for arg in method if arg.get("direction", "in") == "in"
        ] != inputs or (initialize and [
            arg.get("type") for arg in method if arg.get("direction") == "out"
        ] != ["o"]):
            raise KeyringError(
                f"Unsupported GNOME keyring private {name} API; no fallback will be attempted."
            )
        if initialize:
            self.assert_absent()
            return True
        self.collection = self.call(SECRETS, "ReadAlias", "(s)", ("login",))[0]
        if self.collection == "/":
            raise KeyringError(
                "Login keyring absent; run make keyring-init in a human terminal. No keyring was created or reset."
            )
        return self.locked()

    def assert_absent(self):
        if self.call(SECRETS, "ReadAlias", "(s)", ("login",))[0] != "/":
            raise KeyringError("Login keyring already exists; no keyring will be created or changed.")

    def locked(self):
        value = self.call(
            "org.freedesktop.DBus.Properties",
            "Get",
            "(ss)",
            ("org.freedesktop.Secret.Collection", "Locked"),
            path=self.collection,
        )[0]
        if not isinstance(value, bool):
            raise KeyringError("Invalid keyring locked-state response.")
        return value

    def unlock(self, password, initialize=False):
        self.assert_owner()
        if initialize:
            self.assert_absent()
        _, session = self.call(SECRETS, "OpenSession", "(sv)", ("plain", ""))
        try:
            self.assert_owner()
            secret = (session, [], list(password.encode()), "text/plain; charset=utf8")
            if initialize:
                self.assert_absent()
                # GNOME derives the intrinsic login identifier from this label;
                # SetAlias only supports 'default', not 'login'.
                self.collection = self.call(
                    INTERNAL, "CreateWithMasterPassword", "(a{sv}(oayays))",
                    ({"org.freedesktop.Secret.Collection.Label": "login"}, secret),
                )[0]
                self.assert_owner()
                if (self.collection == "/" or
                        self.call(SECRETS, "ReadAlias", "(s)", ("login",))[0] != self.collection):
                    raise KeyringError("Created collection is not the login keyring; no retry or reset attempted.")
            else:
                self.call(INTERNAL, "UnlockWithMasterPassword", "(o(oayays))",
                          (self.collection, secret))
            self.assert_owner()
            if self.locked():
                raise KeyringError("Login keyring is still locked after the request.")
            if initialize:
                self.assert_owner()
                self.call(SECRETS, "SetAlias", "(so)", ("default", self.collection))
                if self.call(SECRETS, "ReadAlias", "(s)", ("default",))[0] != self.collection:
                    raise KeyringError("Login keyring created, but default alias verification failed.")
        finally:
            try:
                self.call(
                    "org.freedesktop.Secret.Session", "Close", "()", (), path=session
                )
            except KeyringError:
                # The session also closes when this CLI disconnects. Preserve
                # the original unlock error if the provider disappeared.
                pass


def read_password():
    try:
        with open("/dev/tty", "w") as terminal:
            if not terminal.isatty():
                raise KeyringError(
                    "Unlock requires a controlling terminal with hidden password input."
                )
            with warnings.catch_warnings():
                warnings.simplefilter("error", getpass.GetPassWarning)
                return getpass.getpass(prompt="Keyring password: ", stream=terminal)
    except (OSError, getpass.GetPassWarning) as error:
        raise KeyringError(
            "Unlock requires a controlling terminal with hidden password input."
        ) from error


@contextlib.contextmanager
def deadline(seconds, exit_code=1):
    # A Python signal handler can wait behind a blocking Gio C call. A watchdog
    # exits this short-lived CLI even then; the OS releases its bus and locks.
    timer = threading.Timer(seconds, lambda: os._exit(exit_code))
    timer.daemon = True
    timer.start()
    try:
        yield
    finally:
        timer.cancel()


def foreground_terminal():
    if not sys.stdin.isatty() or not sys.stderr.isatty():
        return False
    try:
        with open("/dev/tty") as terminal:
            return os.tcgetpgrp(terminal.fileno()) == os.getpgrp()
    except OSError:
        return False


@contextlib.contextmanager
def startup_lock():
    import fcntl

    acquired = False
    with contextlib.ExitStack() as resources:
        try:
            runtime = os.environ.get("XDG_RUNTIME_DIR", "")
            if not os.path.isabs(runtime):
                raise OSError("no private runtime directory")
            directory = os.open(runtime, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            resources.callback(os.close, directory)
            info = os.fstat(directory)
            if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
                raise OSError("unsafe runtime directory")
            address = os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path={runtime}/bus"
            name = "dotfiles-keyring-" + hashlib.sha256(address.encode()).hexdigest()[:16] + ".lock"
            lock = os.open(name, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600, dir_fd=directory)
            resources.callback(os.close, lock)
            info = os.fstat(lock)
            if (info.st_uid != os.getuid() or not stat.S_ISREG(info.st_mode)
                    or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1):
                raise OSError("unsafe prompt lock")
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            acquired = True
        except OSError:
            pass
        yield acquired


def startup(provider_factory=None, prompt=read_password):
    previous = signal.getsignal(signal.SIGTSTP)

    def cancel(signum, frame):
        raise KeyboardInterrupt

    # Cover inspection as well as password input: suspending a lock holder
    # before the prompt would silently prevent every later shell from prompting.
    signal.signal(signal.SIGTSTP, cancel)
    try:
        if not foreground_terminal():
            return 0
        with startup_lock() as acquired:
            if not acquired:
                return 0
            try:
                with deadline(2, exit_code=0):
                    provider = (provider_factory or GnomeKeyring)()
                    if not provider.inspect(activate=True):
                        return 0
            except KeyringError:
                # Automatic startup stays quiet on hosts without this integration.
                return 0
            print("GitHub keyring is locked; unlock for this user session (Ctrl-C to skip).", file=sys.stderr)
            password = prompt()
            if not password:
                raise KeyringError("Password must not be empty.")
            with deadline(10, exit_code=0):
                provider.unlock(password)
    except (EOFError, KeyboardInterrupt):
        print("\nkeyring: Cancelled; unlock later with make keyring-unlock.", file=sys.stderr)
    except KeyringError as error:
        print(f"keyring: {error}", file=sys.stderr)
    finally:
        signal.signal(signal.SIGTSTP, previous)
    return 0


def auth_free(args):
    if not args or args[0] in ("help", "--help", "-h", "version", "--version", "completion"):
        return True
    if args[1:] == ["--help"]:
        return True
    if len(args) == 3 and args[:2] in (
        ["auth", "login"], ["auth", "status"], ["auth", "git-credential"],
    ) and args[2] == "--help":
        return True
    if args[0] in ("config", "alias") and len(args) > 1:
        return args[1] in ({"config": ("get", "list", "set"), "alias": ("list", "set", "delete")}[args[0]])
    # gh implements store/erase as no-ops; unknown operations report native
    # validation errors without consulting credentials (cli/cli v2.103.2).
    if args[:2] != ["auth", "git-credential"]:
        return False
    operation = args[2:]
    if "--" in operation:
        operation.remove("--")
    return operation != ["get"]


def gh_check(args, provider_factory=None):
    if args[:1] == ["--"]:
        args = args[1:]
    with deadline(2):
        if auth_free(args):
            return 0
        login = args[:2] == ["auth", "login"]
        if not login:
            if any(os.environ.get(key) for key in (
                "GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN",
            )):
                return 0
            directory = os.environ.get("GH_CONFIG_DIR")
            if not directory:
                if os.environ.get("XDG_CONFIG_HOME"):
                    directory = os.path.join(os.environ["XDG_CONFIG_HOME"], "gh")
                else:
                    directory = os.path.expanduser("~/.config/gh")
            try:
                with (pathlib.Path(directory) / "hosts.yml").open() as hosts:
                    # Presence only: never extract or report token values. A
                    # mixed-host config deliberately delegates to gh's resolver.
                    if any(re.match(r'''\s*["']?oauth_token["']?\s*:''', line) for line in hosts):
                        return 0
            except (OSError, UnicodeError):
                # No configured keyring dependency, or a malformed config that
                # gh can diagnose more accurately. Never force enrollment.
                return 0
        try:
            provider = (provider_factory or GnomeKeyring)()
            return int(provider.inspect())
        except UnsupportedProvider:
            return 0
        except KeyringError:
            return 1


def run(command, provider, prompt=read_password):
    initialization_requested = False
    try:
        initialize = command == "init"
        if initialize and not foreground_terminal():
            raise KeyringError("Initialization requires a foreground human terminal.")
        if not provider.inspect(activate=command in ("unlock", "init"), initialize=initialize):
            print("Login keyring unlocked.")
            return 0
        if command == "check":
            print("Login keyring locked; run make keyring-unlock.")
            return 1
        password = prompt()
        if not password:
            raise KeyringError("Password must not be empty.")
        if initialize:
            print("Confirm new keyring password:", file=sys.stderr)
            if prompt() != password:
                raise KeyringError("Passwords do not match; no keyring was created.")
            initialization_requested = True
            provider.unlock(password, initialize=True)
            initialization_requested = False
            print("Login keyring created, unlocked and set as default.")
        else:
            provider.unlock(password)
            print("Login keyring unlocked.")
        return 0
    except KeyringError as error:
        print(f"keyring: {error}", file=sys.stderr)
        return 1
    except (EOFError, KeyboardInterrupt):
        print("\nkeyring: Cancelled.", file=sys.stderr)
        return 1
    finally:
        if initialization_requested:
            print("keyring: A keyring may have been created; run make keyring-check before further action. No retry or reset was attempted.", file=sys.stderr)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("check", "init", "unlock", "startup", "gh-check"))
    parser.add_argument("gh_args", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    if args.command == "init" and args.gh_args:
        parser.error("This command accepts no extra arguments; passwords require hidden terminal input.")
    if args.command == "init" and not foreground_terminal():
        print("keyring: Initialization requires a foreground human terminal.", file=sys.stderr)
        return 1
    if sys.platform != "linux":
        print(
            "keyring: Linux GNOME keyring only; native macOS Keychain is unchanged.",
            file=sys.stderr,
        )
        return 1
    if args.command == "startup":
        return startup()
    if args.command == "gh-check":
        return gh_check(args.gh_args)
    try:
        provider = GnomeKeyring()
    except KeyringError as error:
        print(f"keyring: {error}", file=sys.stderr)
        return 1
    return run(args.command, provider)


if __name__ == "__main__":
    sys.exit(main())
