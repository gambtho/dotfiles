#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
pi_package_root=""
args=("$@")
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pi-package-root)
      [[ $# -ge 2 && "$2" == /* ]] || {
        printf 'error: --pi-package-root requires an absolute path\n' >&2
        exit 2
      }
      pi_package_root=$2
      shift 2
      ;;
    *) shift ;;
  esac
done
[[ -n "$pi_package_root" ]] || {
  printf 'error: --pi-package-root is required\n' >&2
  exit 2
}

source "$ROOT/libexec/lib/pi-runtime.sh"
resolve_pi_runtime "" "$pi_package_root"
# Use the selected host API rather than an ambient npm/global Pi installation.
JITI_ALIAS=$(node -e 'console.log(JSON.stringify({
  "@earendil-works/pi-coding-agent": process.argv[1],
}))' "$PI_RUNTIME_PACKAGE_ROOT/dist/index.js")
export JITI_ALIAS
export JITI_FS_CACHE=false NODE_DISABLE_COMPILE_CACHE=1
exec node "$PI_RUNTIME_JITI_CLI" "$ROOT/libexec/pi-package-lifecycle.ts" "${args[@]}"
