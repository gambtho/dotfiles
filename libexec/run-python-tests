#!/usr/bin/env python3

"""Run a unittest suite one TestCase class per process, several at a time.

Discovery matches `python3 -m unittest discover -s DIR -p 'test_*.py'`; each
class then runs through that same discovery, filtered to the class, so imports
and sys.path behave as in a single serial run.
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import time
import unittest
from concurrent.futures import ThreadPoolExecutor, as_completed


def iter_tests(suite):
    for item in suite:
        if isinstance(item, unittest.TestSuite):
            yield from iter_tests(item)
        else:
            yield item


def discover(start: str) -> tuple[dict[tuple[str, str], int], list[str]]:
    units: dict[tuple[str, str], int] = {}
    errors: list[str] = []
    suite = unittest.defaultTestLoader.discover(start, pattern='test_*.py', top_level_dir=start)
    for test in iter_tests(suite):
        if isinstance(test, unittest.loader._FailedTest):  # import or load failure
            errors.append(f'{test.id()}: {test._exception}')
            continue
        key = (type(test).__module__, type(test).__qualname__)
        units[key] = units.get(key, 0) + 1
    return units, errors


def run_unit(start: str, module: str, cls: str) -> tuple[int, str, float]:
    began = time.monotonic()
    result = subprocess.run(
        [sys.executable, '-m', 'unittest', 'discover', '-s', start, '-t', start,
         '-p', f"{module.rpartition('.')[2]}.py", '-k', f'{module}.{cls}.*'],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, check=False)
    return result.returncode, result.stdout, time.monotonic() - began


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('start', nargs='?', default='tests/python')
    parser.add_argument('--jobs', type=int, default=int(os.environ.get('JOBS') or os.cpu_count() or 1))
    args = parser.parse_args()
    if args.jobs < 1:
        parser.error('--jobs must be at least 1')

    began = time.monotonic()
    units, errors = discover(args.start)
    for error in errors:
        print(f'error: cannot load {error}', file=sys.stderr)
    if not units and not errors:
        print(f'error: no tests found under {args.start}', file=sys.stderr)
        return 1

    expected = sum(units.values())
    ran = 0
    failed: list[str] = []
    # Bigger classes first, so the longest work starts before the pool drains.
    order = sorted(units, key=lambda key: (-units[key], key))
    with ThreadPoolExecutor(max_workers=args.jobs) as pool:
        futures = {pool.submit(run_unit, args.start, module, cls): f'{module}.{cls}' for module, cls in order}
        for future in as_completed(futures):
            name = futures[future]
            code, output, seconds = future.result()
            match = re.search(r'^Ran (\d+) tests?', output, re.M)
            count = int(match.group(1)) if match else 0
            ran += count
            if code != 0:
                failed.append(name)
                print(f'FAIL {name} ({seconds:.1f}s)\n{output}', flush=True)
            else:
                print(f'ok   {name}: {count} tests ({seconds:.1f}s)', flush=True)

    print(f'Ran {ran} tests in {len(units)} classes, {args.jobs} jobs, {time.monotonic() - began:.1f}s')
    if ran != expected:
        print(f'error: discovered {expected} tests but ran {ran}', file=sys.stderr)
        return 1
    if failed or errors:
        print(f"FAILED: {', '.join(failed + [e.split(':', 1)[0] for e in errors])}", file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
