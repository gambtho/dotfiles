#!/usr/bin/env bash
# Validate the tracked Pi configuration baselines and repository symlinks.
# The skills package lives in gambtho/gambtho-skills and validates itself.
# Usage: libexec/validate-ai [--verbose]

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
ERRORS=0
WARNINGS=0
VERBOSE=false

[[ "${1:-}" == "--verbose" ]] && VERBOSE=true

error() {
  echo "  ERROR: $1"
  ERRORS=$((ERRORS + 1))
}
info() { $VERBOSE && echo "  OK:    $1" || true; }

resolve_existing_path() {
  local path="$1" directory base target attempts=0
  while [ "$attempts" -lt 40 ]; do
    directory=$(cd -P "$(dirname "$path")" 2>/dev/null && pwd -P) || return 1
    base=$(basename "$path")
    path="$directory/$base"
    if [ ! -L "$path" ]; then
      [ -e "$path" ] || return 1
      printf '%s\n' "$path"
      return 0
    fi
    target=$(readlink "$path") || return 1
    case "$target" in
      /*) path=$target ;;
      *) path="$directory/$target" ;;
    esac
    attempts=$((attempts + 1))
  done
  return 1
}

validate_pi_json() {
  local file=$1 label
  label=${file#"$DOTFILES_ROOT/ai/pi/"}
  if ! jq empty "$file" 2>/dev/null; then
    error "$label: invalid JSON"
    return 1
  fi
  info "$label: valid JSON"
}

validate_web_security_baseline() {
  local file="$DOTFILES_ROOT/ai/pi/config/web-search.json" credential_keys key
  jq empty "$file" >/dev/null 2>&1 || return 0

  credential_keys=$(jq -r '
    [.. | objects | keys[]
      | select(test("apikey|api_key|token|secret|password|credential"; "i"))]
    | unique | .[]
  ' "$file")
  if [[ -n "$credential_keys" ]]; then
    while IFS= read -r key; do
      [[ -n "$key" ]] && error "config/web-search.json: credential-like property is forbidden: $key"
    done <<<"$credential_keys"
  fi

  for key in provider searchProvider; do
    if jq -e --arg key "$key" 'has($key)' "$file" >/dev/null; then
      error "config/web-search.json: must not declare $key; use searchRouting.providers"
    fi
  done
}

echo "=== Validating Pi configuration ==="

echo
echo "Pi JSON:"
if ! command -v jq &>/dev/null; then
  error "Pi JSON: jq is required for validation"
else
  pi_json_files=(
    "$DOTFILES_ROOT/ai/pi/settings.json"
    "$DOTFILES_ROOT/ai/pi/keybindings.json"
    "$DOTFILES_ROOT"/ai/pi/config/*.json
  )
  for pi_json in "${pi_json_files[@]}"; do
    [[ -f "$pi_json" ]] || {
      error "Pi JSON file does not exist: ${pi_json#"$DOTFILES_ROOT/"}"
      continue
    }
    validate_pi_json "$pi_json" || true
  done
  validate_web_security_baseline
fi

echo
echo "Tracked symlinks:"
while IFS= read -r -d '' entry; do
  metadata=${entry%%$'\t'*}
  path=${entry#*$'\t'}
  mode=${metadata%% *}
  [ "$mode" = 120000 ] || continue
  link="$DOTFILES_ROOT/$path"
  [ -L "$link" ] || continue
  target=$(readlink "$link")
  if [[ "$target" = /* ]]; then
    error "$path: tracked symlink target must be relative: $target"
    continue
  fi
  resolved_target=$(resolve_existing_path "$(dirname "$link")/$target") || {
    error "$path: tracked symlink does not resolve: $target"
    continue
  }
  case "$resolved_target" in
    "$DOTFILES_ROOT"/*) info "$path -> $target" ;;
    *) error "$path: tracked symlink resolves outside repository: $target" ;;
  esac
done < <(git -C "$DOTFILES_ROOT" ls-files -s -z)

echo
echo "=== Summary ==="
echo "  Errors:   $ERRORS"
echo "  Warnings: $WARNINGS"

if [ "$ERRORS" -gt 0 ]; then
  echo
  echo "FAILED: $ERRORS errors found"
  exit 1
fi

echo
echo "PASSED"
