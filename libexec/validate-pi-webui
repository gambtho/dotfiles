#!/usr/bin/env bash
# Validate the byte-pinned Pi Web UI runtime and, optionally, an npm installation.

set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
runtime_root="$ROOT/ai/pi/webui/runtime"
mode=tracked
usage="usage: $0 [--tracked-only [RUNTIME_ROOT] | --installed-runtime RUNTIME_ROOT]"

case "${1:-}" in
  '') ;;
  --tracked-only)
    shift
    if [[ $# -gt 0 ]]; then
      runtime_root=$1
      shift
    fi
    ;;
  --installed-runtime)
    [[ $# -ge 2 ]] || {
      printf '%s\n' "$usage" >&2
      exit 2
    }
    mode=installed
    runtime_root=$2
    shift 2
    ;;
  *)
    printf '%s\n' "$usage" >&2
    exit 2
    ;;
esac
[[ $# -eq 0 ]] || {
  printf '%s\n' "$usage" >&2
  exit 2
}

if command -v node >/dev/null 2>&1; then
  node_command=(node)
elif command -v mise >/dev/null 2>&1; then
  node_command=(mise exec -- node)
else
  printf 'error: Node.js is required to validate the Pi Web UI runtime\n' >&2
  exit 1
fi

"${node_command[@]}" - "$runtime_root" "$mode" <<'NODE'
const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');

const [runtimeArgument, mode] = process.argv.slice(2);
const webuiName = '@firstpick/pi-package-webui';
const webuiVersion = '0.10.4';
const piName = '@earendil-works/pi-coding-agent';
const piVersion = '0.85.1';
const manifestHash = '6f01ecc53b5691dd3f34f338d12fd222f9971c4a33f7ce709406bccc44fe7ef4';
const lockHash = '324fef85b346363d358d764527bb73492e1c43330411baf127aa4408bf274123';
const webuiIntegrity = 'sha512-7Fd6aoy35trczFzkKDm1xMsfOTHeMt0SZgoJWorWNEAOfhekQ/FcyH65AP0YlnIeRrH/gNXaS+H77JilYyIJsw==';
const nestedPrefix = 'node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/';
// Pi ships its own npm-shrinkwrap.json for this subtree (packages[...].hasShrinkwrap
// is true on the top-level entry), so npm does not record a separate integrity
// hash for each nested package here -- the top-level Pi tarball hash already
// covers the whole shrinkwrapped subtree. Every nested package must still
// resolve to the exact pinned Pi version and none may carry its own
// unexpected integrity field.
const nestedEarendilNames = ['chord', 'pi-agent-core', 'pi-ai', 'pi-telemetry', 'pi-tui'];

function fail(message) { throw new Error(message); }
function hash(raw) { return crypto.createHash('sha256').update(raw).digest('hex'); }
function read(file, label) {
  try { return fs.readFileSync(file, 'utf8'); }
  catch (error) { fail(`${label} is unavailable: ${error.message}`); }
}
function parse(raw, label) {
  try { return JSON.parse(raw); }
  catch (error) { fail(`${label} is not valid JSON: ${error.message}`); }
}
function requireExecutable(file, label) {
  try {
    const metadata = fs.statSync(file);
    if (!metadata.isFile()) fail(`${label} must be a file`);
    fs.accessSync(file, fs.constants.X_OK);
  } catch (error) {
    fail(`${label} must be executable: ${error.message}`);
  }
}
function rejectNodePty(directory) {
  for (const entry of fs.readdirSync(directory, {withFileTypes: true})) {
    if (!entry.isDirectory()) continue;
    const child = path.join(directory, entry.name);
    if (entry.name === 'node-pty' && path.basename(directory) === 'node_modules') {
      fail(`node-pty must not be installed: ${child}`);
    }
    rejectNodePty(child);
  }
}

try {
  const runtime = path.resolve(runtimeArgument);
  if (mode === 'installed') {
    const metadata = fs.lstatSync(runtime);
    if (metadata.isSymbolicLink()) fail('installed runtime root must not be a symbolic link');
    if (!metadata.isDirectory()) fail('installed runtime root must be a directory');
  }

  const manifestRaw = read(path.join(runtime, 'package.json'), 'runtime manifest');
  const lockRaw = read(path.join(runtime, 'package-lock.json'), 'runtime lock');
  const actualManifestHash = hash(manifestRaw);
  const actualLockHash = hash(lockRaw);
  if (actualManifestHash !== manifestHash) {
    fail(`manifest SHA-256 must be ${manifestHash}; got ${actualManifestHash}`);
  }
  if (actualLockHash !== lockHash) {
    fail(`lock SHA-256 must be ${lockHash}; got ${actualLockHash}`);
  }

  const manifest = parse(manifestRaw, 'runtime manifest');
  const lock = parse(lockRaw, 'runtime lock');
  const dependencyNames = Object.keys(manifest.dependencies || {});
  if (manifest.name !== 'pi-webui-runtime' || manifest.version !== '0.0.0' ||
      dependencyNames.length !== 1 || manifest.dependencies[webuiName] !== webuiVersion) {
    fail(`manifest identity must be pi-webui-runtime@0.0.0 with only ${webuiName}@${webuiVersion}`);
  }
  const root = lock.packages?.[''];
  if (lock.lockfileVersion !== 3 || Object.keys(root?.dependencies || {}).length !== 1 ||
      root.dependencies[webuiName] !== webuiVersion) {
    fail('lockfile must be version 3 with the exact root dependency');
  }
  const registryEntries = Object.entries(lock.packages).filter(([name]) => name !== '');
  if (registryEntries.length !== 379 || registryEntries.some(([, value]) =>
    typeof value.resolved !== 'string' || !value.resolved.startsWith('https://registry.npmjs.org/'))) {
    fail('lockfile must contain exactly 379 registry entries');
  }
  const webui = lock.packages[`node_modules/${webuiName}`];
  if (webui?.version !== webuiVersion || webui.integrity !== webuiIntegrity) {
    fail('unexpected Firstp1ck package identity or integrity');
  }
  const nestedEarendilEntries = Object.keys(lock.packages)
    .filter((name) => name.startsWith(nestedPrefix));
  if (nestedEarendilEntries.length !== nestedEarendilNames.length) {
    fail('unexpected nested Earendil package count');
  }
  for (const name of nestedEarendilNames) {
    const entry = lock.packages[`${nestedPrefix}${name}`];
    if (entry?.version !== piVersion || 'integrity' in entry) {
      fail(`unexpected nested Earendil package: ${name}`);
    }
  }

  if (mode === 'installed') {
    const installedWebui = parse(read(path.join(runtime, 'node_modules', webuiName, 'package.json'),
      'installed Firstp1ck manifest'), 'installed Firstp1ck manifest');
    if (installedWebui.name !== webuiName || installedWebui.version !== webuiVersion ||
        installedWebui.bin?.['pi-webui'] !== './bin/pi-webui-launcher.mjs') {
      fail(`installed Firstp1ck identity must be ${webuiName}@${webuiVersion}`);
    }
    const installedPi = parse(read(path.join(runtime, 'node_modules', piName, 'package.json'),
      'installed Pi manifest'), 'installed Pi manifest');
    if (installedPi.name !== piName || installedPi.version !== piVersion ||
        installedPi.bin?.pi !== 'dist/bundle/cli.js') {
      fail(`installed Pi identity must be ${piName}@${piVersion}`);
    }
    requireExecutable(path.join(runtime, 'node_modules/.bin/pi-webui'), 'installed pi-webui launcher');
    requireExecutable(path.join(runtime, 'node_modules', webuiName, 'bin/pi-webui-launcher.mjs'),
      'installed Firstp1ck executable');
    requireExecutable(path.join(runtime, 'node_modules', piName, 'dist/bundle/cli.js'),
      'installed Pi executable');
    rejectNodePty(path.join(runtime, 'node_modules'));
  }
  console.log('validated 379 registry packages');
} catch (error) {
  console.error(`error: ${error.message}`);
  process.exit(1);
}
NODE
