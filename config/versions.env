PREZTO_REPO=https://github.com/sorin-ionescu/prezto.git
PREZTO_REF=cff2d01871425b1b80710f8ec6a475c5a53145b4
ZSH_DEFER_REPO=https://github.com/romkatv/zsh-defer.git
ZSH_DEFER_REF=53a26e287fbbe2dcebb3aa1801546c6de32416fa
# Operator-owned compatibility policy, not a version to chase: this must match
# the minor your cluster actually runs. `bin/versions update` reports upstream
# drift but never picks a new minor, because moving it is a cluster decision.
KUBERNETES_CHANNEL=v1.28
# Krew, the kubectl plugin manager the work profile installs ctx and ns through.
# macOS gets it from platforms/macos/brewfile; Linux and WSL have no package for
# it, so the work profile installs this pinned release tarball instead. Upstream
# publishes a .sha256 beside each asset; these were recomputed from the actual
# downloads rather than copied from it.
KREW_VERSION=v0.5.0
KREW_RELEASE_BASE=https://github.com/kubernetes-sigs/krew/releases/download/v0.5.0
KREW_LINUX_AMD64_SHA256=5d5a221fffdf331d1c5c68d9917530ecd102e0def5b5a6d62eeed1c404efb28a
KREW_LINUX_ARM64_SHA256=ab7a98b992424e76b6c162f8b67fb76c4b1e243598aa2807bdf226752f964548
MISE_VERSION=v2026.7.18
MISE_RELEASE_BASE=https://github.com/jdx/mise/releases/download/v2026.7.18
MISE_LINUX_X64_SHA256=e1fc2899f2bc7dfe9a3553f4c2d5944cf69d11b5f561545504a20f1e11cd6cc5
MISE_LINUX_ARM64_SHA256=7d96bad004ba706d7ce4e999113f61296ff317ad23754471743be883817e8a75
YQ_VERSION=v4.45.1
YQ_RELEASE_BASE=https://github.com/mikefarah/yq/releases/download/v4.45.1
YQ_LINUX_AMD64_SHA256=654d2943ca1d3be2024089eb4f270f4070f491a0610481d128509b2834870049
YQ_LINUX_ARM64_SHA256=ceea73d4c86f2e5c91926ee0639157121f5360da42beeb8357783d79c2cc6a1d
WIN32YANK_VERSION=v0.1.1
WIN32YANK_RELEASE_BASE=https://github.com/equalsraf/win32yank/releases/download/v0.1.1
WIN32YANK_WINDOWS_X64_SHA256=247c9a05b94387a884b49d3db13f806b1677dfc38020f955f719be6902260cd6
NERD_FONTS_VERSION=v3.4.0
NERD_FONTS_RELEASE_BASE=https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0
NERD_FONT_CASCADIA_MONO_SHA256=95dc4ace16f5a45734fc584925b9ef24c23f46d54a3b66082bac1e3841a41593
NERD_FONT_HACK_SHA256=8ca33a60c791392d872b80d26c42f2bfa914a480f9eb2d7516d9f84373c36897
NERD_FONT_MESLO_SHA256=13b502ac8c2bd9d3161018064560e23cd42b175bb730780a270975265a19ad57
PI_VERSION=0.84.4
# Pi extensions execute with the user's authority. Keep these reviewed refs in
# one inventory; settings.json is checked against them and updates are manual.
PI_QUEUE_STEER_REF=v0.2.0
PI_WEB_ACCESS_VERSION=0.27.0
PI_LSP_VERSION=0.49.6
PI_SUBAGENTS_VERSION=21.2.0
PI_PERMISSION_SYSTEM_VERSION=29.2.0
PI_SANDBOX_REF=53bd1d64d896d4a6bfab3769023201891e76ba72
# Neovim: the OS package layer supplies this on a normal host, but containers
# get these dotfiles without it, and Debian bookworm's apt candidate is 0.7.2 —
# too old for config/nvim (it uses vim.uv and lazy.nvim). Pinned + checksummed
# because upstream publishes no checksum file with the release assets.
NVIM_VERSION=0.12.4
NVIM_SHA256_X86_64=012bf3fcac5ade43914df3f174668bf64d05e049a4f032a388c027b1ebd78628
NVIM_SHA256_ARM64=ceb7e88c6b681f0515d135dcdfad54f5eb4373b25ce6172197cd9a69c758063f
# tree-sitter CLI: config/nvim pins nvim-treesitter to its `main` branch, which
# shells out to `tree-sitter build` for every parser — there is no fallback to a
# bare `cc`, so without this binary every parser fails with
# `ENOENT ... (cmd): 'tree-sitter'`. On a host it arrives via mise
# (npm:tree-sitter-cli in config/mise/config.toml); containers never run mise,
# hence the pinned release binary here. Keep the version in step with the mise
# pin. The assets are single gzipped binaries (.gz, not tarballs) and upstream
# publishes no checksum file, so these are computed from the release downloads.
TREE_SITTER_VERSION=0.26.11
TREE_SITTER_SHA256_X86_64=8dac3c89bb632eece700ea7a261ad963b251f2228c4aef3b58458ebea8dbe4eb
TREE_SITTER_SHA256_ARM64=e47dd59bf2f21ad7c15771546a724464ee3c008a60fbb61c6860bd19a44b3060
# Herdr, the terminal workspace runtime for coding agents. Replaced ProjectMux
# here; the ProjectMux repo is still developed, it is just no longer installed
# by this bootstrap.
#
# Upstream publishes no checksum file alongside the release, so these digests
# were computed from the downloaded artifacts and are trust-on-first-use. Herdr
# also self-updates by default; tools/herdr/config.toml.template turns
# version_check off so the binary cannot drift away from these digests, which
# makes `make pins-check` the one place a new release shows up.
#
# Upstream also ships darwin assets, but the installer is Linux-only by design
# — macOS would come through platforms/macos/brewfile.
HERDR_VERSION=v0.8.0
HERDR_RELEASE_BASE=https://github.com/herdrdev/herdr/releases/download/v0.8.0
HERDR_LINUX_X86_64_SHA256=b872ea7e40fa2cb17e857ac9b62b1bf26db7b403c622f5d2f3f5b35f6e9acd28
HERDR_LINUX_AARCH64_SHA256=f647ac66468d9efbc642fe534fb284468f0aea60641606fc008dfc0d82a3ca87

# The Dev Container plugin that tools/herdr/config.toml.template binds to
# prefix+d and prefix+shift+s. Pinned to a tag rather than tracking the default
# branch, so a bootstrap installs a reviewed revision. There is no digest to
# record: `herdr plugin install` resolves the ref to a commit and builds from
# source, so the ref is the pin.
HERDR_DEVCONTAINER_REPO=gambtho/herdr-devcontainer
HERDR_DEVCONTAINER_REF=v0.2.0
